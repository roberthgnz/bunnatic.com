{
  "name": "locavo.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "lighthouse": "lighthouse https://www.locavo.com/ --view",
    "lighthouse:local": "lighthouse http://localhost:3000/ --view",
    "test:perf": "node -e \"console.log('Run: .\\\\scripts\\\\test-performance.ps1 (Windows) or bash scripts/test-performance.sh (Unix)')\"",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf:typegen": "wrangler types --include-runtime false",
    "db:migrate:local": "wrangler d1 migrations apply locavo --local",
    "db:migrate:remote": "wrangler d1 migrations apply locavo --remote",
    "check:cloudflare": "vinext check",
    "check:seo": "tsx scripts/check-seo.ts"
  },
  "dependencies": {
    "@auth/d1-adapter": "^1.11.3",
    "@google/genai": "^1.17.0",
    "@hookform/resolvers": "^5.2.1",
    "@mendable/firecrawl-js": "^4.15.4",
    "@react-email/components": "1.0.9",
    "accordion": "^3.0.2",
    "add": "^2.0.6",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dlx": "^0.2.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pnpm": "^10.32.0",
    "postcss": "^8.5.6",
    "radix-ui": "^1.4.3",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.8.0",
    "resend": "^6.9.3",
    "shadcn": "^4.0.2",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "undici": "^7.22.0",
    "vinext": "^1.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "dotenv": "^16.4.7",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.12",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "4.1.11",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8",
    "wrangler": "^4.153.0"
  },
  "type": "module"
}
